// Settings for the ProxmoxBarTests target.
//
// The suite is hosted by the application, so running four unit tests launches
// ProxmoxBar. That is a property of @testable import against an app target and
// is the reason the logic is moving into a package. See docs/ADR/0017.

BUNDLE_LOADER = $(TEST_HOST)
TEST_HOST = $(BUILT_PRODUCTS_DIR)/ProxmoxBar.app/Contents/MacOS/ProxmoxBar

PRODUCT_NAME = ProxmoxBarTests
PRODUCT_BUNDLE_IDENTIFIER = com.proxmoxbar.app.tests
SWIFT_MODULE_NAME = ProxmoxBarTests

COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks
